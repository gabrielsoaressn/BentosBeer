# Copie para .env e ajuste. O .env nunca vai para o Git.
#
# Se você usar o container do projeto (npm run db:up), estes valores já servem.
# Se você usar um MySQL 8 próprio, mude aqui e nada mais no código precisa mudar.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=bentosbeer
DB_NAME=bentosbeer

# Porta do servidor web
PORT=3000
