{
  "name": "bentos-beer",
  "version": "2.0.0",
  "description": "Sistema de gerenciamento de bar — trabalho de Banco de Dados, UFPB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "node db/reset.js",
    "test": "node db/reset.js --banco-de-teste && node --test --test-concurrency=1 tests/",
    "demo:dados": "node db/exportar-demo.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mysql2": "^3.11.0"
  },
  "author": "Gabriel, Rivando e Rafael",
  "license": "ISC",
  "private": true
}
